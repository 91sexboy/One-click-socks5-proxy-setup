#!/bin/sh
# tests/stubs/make - test stub for make. Records argv to the transcript and
# produces a fake bin/3proxy artifact in the current directory.
#
# Marker files inside $S5_TEST_ROOT:
#   stub_make_fail         -> make exits non-zero
#   stub_make_noartifact   -> make succeeds but produces no bin/3proxy

T="$S5_TEST_ROOT/transcript"
printf 'make' >>"$T"
for a in "$@"; do printf ' %s' "$a" >>"$T"; done
printf '\n' >>"$T"

if [ -f "$S5_TEST_ROOT/stub_make_fail" ]; then
    printf 'stub make: compilation failed\n' >&2
    exit 2
fi

if [ -f "$S5_TEST_ROOT/stub_make_noartifact" ]; then
    exit 0
fi

mkdir -p bin
printf '#!/bin/sh\nprintf "stub-3proxy\\n"\n' >bin/3proxy
chmod 0755 bin/3proxy
# Auxiliary binaries the real build also produces; only bin/3proxy may be taken.
printf 'aux\n' >bin/3proxy_crypt
printf 'aux\n' >bin/3proxy_socks
exit 0
