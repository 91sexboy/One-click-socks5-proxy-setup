#!/bin/sh
# tests/stubs/curl - test stub. Records argv, captures stdin, and simulates a
# SOCKS5 proxy check: it succeeds only when the credentials supplied on stdin
# match $S5_TEST_ROOT/expected_creds.
#
# Because the real script must pass credentials on stdin only, the transcript
# (argv) can be asserted to be secret-free.
#
# Markers in $S5_TEST_ROOT: stub_curl_all_fail, stub_no_egress

T="$S5_TEST_ROOT/transcript"
printf 'curl' >>"$T"
for a in "$@"; do printf ' %s' "$a" >>"$T"; done
printf '\n' >>"$T"

if [ "${1:-}" = "-q" ]; then
    shift
fi

emit_engine_asset() {
    if [ -f "$S5_TEST_ROOT/stub_asset_truncated" ]; then
        _size=$(wc -c <"$S5_TEST_ROOT/stub_engine_asset")
        head -c "$((_size - 1))" "$S5_TEST_ROOT/stub_engine_asset"
    elif [ -f "$S5_TEST_ROOT/stub_asset_corrupt" ]; then
        sed '1s/./X/' "$S5_TEST_ROOT/stub_engine_asset"
    else
        cat "$S5_TEST_ROOT/stub_engine_asset"
    fi
    if [ -f "$S5_TEST_ROOT/stub_asset_oversized_unknown" ]; then
        dd if=/dev/zero bs=8192 count=1 2>/dev/null | tr '\000' X
    fi
}

case "$*" in
*'/releases/download/engine-3proxy-0.9.9.0-r1/3proxy-'* | \
*'/releases/download/engine-3proxy-0.9.9.0-r2/3proxy-'*)
    if [ -f "$S5_TEST_ROOT/stub_asset_download_fail" ]; then
        exit 22
    fi
    _out=''
    _prev=''
    for _a in "$@"; do
        if [ "$_prev" = "--output" ] || [ "$_prev" = "-o" ]; then
            _out=$_a
        fi
        _prev=$_a
    done
    [ -n "$_out" ] || exit 2
    if [ "$_out" = - ]; then
        emit_engine_asset
        if [ -f "$S5_TEST_ROOT/stub_asset_oversized_unknown" ]; then exit 23; fi
    else
        emit_engine_asset >"$_out"
    fi
    exit 0
    ;;
esac

if [ "${1:-}" = "--config" ] && [ "${2:-}" = "-" ]; then
    IN="$S5_TEST_ROOT/curl_stdin"
    cat >>"$IN"
    if [ -f "$S5_TEST_ROOT/stub_curl_all_fail" ]; then
        printf 'curl: (97) proxy handshake failed\n' >&2
        exit 97
    fi
    if [ -f "$S5_TEST_ROOT/stub_curl_legacy_auth_reject" ]; then
        printf 'curl: (7) User was rejected by the SOCKS5 server (1 1).\n' >&2
        exit 7
    fi
    # An arbitrary NON-97 failure on the proxy path. s5_selftest_bad treats only
    # curl 97 (CURLE_PROXY) as proof that the *proxy* refused the credential;
    # anything else is "inconclusive, refusing to continue". Without this marker
    # the stub could emit only 0 or 97 here, so that discrimination -- the entire
    # reason the bad-credential probe means anything -- had no input that reached
    # it and could be deleted with the suite still green.
    if [ -f "$S5_TEST_ROOT/stub_curl_code" ]; then
        _cc=$(cat "$S5_TEST_ROOT/stub_curl_code")
        printf 'curl: (%s) simulated non-proxy failure\n' "$_cc" >&2
        exit "$_cc"
    fi
    # Simulates a broken proxy that accepts ANY credentials, so the
    # bad-credential rejection check can be proven to actually fail.
    if [ -f "$S5_TEST_ROOT/stub_curl_accept_all" ]; then
        exit 0
    fi
    got=$(grep '^proxy-user' "$IN" | tail -n 1 | sed -e 's/^[^=]*=[[:space:]]*//' -e 's/^"//' -e 's/"$//')
    if [ -f "$S5_TEST_ROOT/expected_creds" ]; then
        want=$(cat "$S5_TEST_ROOT/expected_creds" 2>/dev/null || printf '')
    elif [ -f "$S5_TEST_ROOT/etc/socks5-manager/users.cfg" ]; then
        want=$(sed 's/:CL:/:/' "$S5_TEST_ROOT/etc/socks5-manager/users.cfg" 2>/dev/null)
    else
        want=''
    fi
    if [ -f "$S5_TEST_ROOT/stub_curl_legacy_differential" ] &&
        [ -n "$want" ] && [ "$got" != "$want" ]; then
        printf 'curl: (7) legacy SOCKS5 ruleset rejection\n' >&2
        exit 7
    fi
    if [ -n "$want" ] && [ "$got" = "$want" ]; then
        exit 0
    fi
    printf 'curl: (97) proxy authentication failed\n' >&2
    exit 97
fi

# public-IPv4 lookup (Round 16 T11): recognized by the fixed endpoint URL.
# The marker file supplies the scripted BODY bytes; its exit code is the HTTP/
# transport outcome. Without the marker the lookup fails like a dead endpoint.
case "$*" in
*https://icanhazip.com*)
    # The HTTP-status marker wins over the body: an error response must never
    # yield its body as a result.
    if [ -f "$S5_TEST_ROOT/stub_ip_code" ]; then
        _ic=$(cat "$S5_TEST_ROOT/stub_ip_code")
        exit "$_ic"
    fi
    if [ -f "$S5_TEST_ROOT/stub_ip_body" ]; then
        # Real curl writes --output FILE; honor it when present so the
        # production capture path (file, not pipe) is exercised.
        _out=''
        _prev=''
        for _a in "$@"; do
            if [ "$_prev" = "--output" ] || [ "$_prev" = "-o" ]; then
                _out=$_a
            fi
            _prev=$_a
        done
        if [ -n "$_out" ]; then
            cat "$S5_TEST_ROOT/stub_ip_body" >"$_out"
        else
            cat "$S5_TEST_ROOT/stub_ip_body"
        fi
        _out=''
        _prev=''
        exit 0
    fi
    exit 7
    ;;
esac

# direct-egress probe (no proxy)
if [ -f "$S5_TEST_ROOT/stub_no_egress" ]; then
    printf 'curl: (7) failed to connect\n' >&2
    exit 7
fi
exit 0
